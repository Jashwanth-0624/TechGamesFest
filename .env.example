# Cashfree API Credentials (from https://merchant.cashfree.com/)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# Environment: SANDBOX (Testing / Compliance Review) or PRODUCTION (Live)
CASHFREE_ENV=SANDBOX

# Port for local Express web server
PORT=3000

